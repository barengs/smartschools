# ==========================================
# Smart School Integrated Ecosystem (.env)
# ==========================================

# PostgreSQL 16 (Single Source of Truth)
POSTGRES_USER=smartschool
POSTGRES_PASSWORD=smartschool_dev_pass
POSTGRES_DB=smartschool_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://smartschool:smartschool_dev_pass@localhost:5432/smartschool_db

# Redis 7 (Event Bus, Cache, BullMQ, CBT Store)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=smartschool_redis_pass

# MinIO / S3 Compatible Object Storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_dev_pass
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://localhost:9000

# IoT MQTT Broker (EMQX)
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TLS_PORT=8883
MQTT_DASHBOARD_PORT=18083

# API Gateway & Backend Service Ports
GATEWAY_PORT=8080
CORE_ERP_PORT=3001
HIGH_SPEED_PORT=3002
AI_SERVICE_PORT=8000

# JWT RS256 (Service A holds Private Key; Service B & C hold Public Key read-only)
JWT_PRIVATE_KEY_PATH=./infra/secrets/private.pem
JWT_PUBLIC_KEY_PATH=./infra/secrets/public.pem
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

